#!/usr/bin/env bash
# main-al-dia — read-only session-start freshness check.
#
# Reports whether the local default branch is behind origin/<default> and
# whether the current branch is behind its upstream. It never checks out,
# merges, stashes or moves local refs; the only write is the `git fetch`
# that refreshes remote-tracking refs. It always exits 0.
set -u

GIT_TERMINAL_PROMPT=0
export GIT_TERMINAL_PROMPT

say() {
  printf '%s\n' "$1"
}

if ! command -v git >/dev/null 2>&1; then
  say "SKIP no-git"
  exit 0
fi

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  say "SKIP not-a-git-work-tree"
  exit 0
fi

if ! git config --get remote.origin.url >/dev/null 2>&1; then
  say "SKIP no-origin-remote"
  exit 0
fi

fetch_failed=0
if command -v timeout >/dev/null 2>&1; then
  timeout 10 git fetch --quiet origin >/dev/null 2>&1 || fetch_failed=1
else
  git fetch --quiet origin >/dev/null 2>&1 || fetch_failed=1
fi
if [ "$fetch_failed" -ne 0 ]; then
  say "SKIP offline"
  exit 0
fi

# Default branch: origin/HEAD first, then main, then master.
default=""
head_ref=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || true)
if [ -n "$head_ref" ]; then
  default=${head_ref#origin/}
fi
if [ -z "$default" ]; then
  if git show-ref --verify --quiet refs/remotes/origin/main; then
    default=main
  elif git show-ref --verify --quiet refs/remotes/origin/master; then
    default=master
  else
    default=master
  fi
fi
origin_default="refs/remotes/origin/$default"

# Commits reachable from $2 but not from $1.
behind_commits() {
  git rev-list --count "$1..$2" 2>/dev/null || printf '0'
}

# An absent local default branch counts as zero behind.
default_behind=0
if git show-ref --verify --quiet "refs/heads/$default"; then
  default_behind=$(behind_commits "refs/heads/$default" "$origin_default")
fi

current=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || printf 'HEAD')

upstream=$(git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || true)
upstream_behind=0
upstream_ahead=0
if [ -n "$upstream" ]; then
  upstream_behind=$(behind_commits HEAD "$upstream")
  upstream_ahead=$(behind_commits "$upstream" HEAD)
fi

behind_default=$(behind_commits HEAD "$origin_default")

if [ -n "$(git status --porcelain 2>/dev/null)" ]; then
  dirty=yes
else
  dirty=no
fi

if [ "$default_behind" = "0" ] && [ "$upstream_behind" = "0" ]; then
  say "OK default=$default"
  exit 0
fi

say "BEHIND default=$default default_behind=$default_behind branch=$current upstream_behind=$upstream_behind upstream_ahead=$upstream_ahead behind_default=$behind_default dirty=$dirty"
exit 0
