#!/usr/bin/env python3
"""carril-medir — compare Pi runs across lanes from their session logs.

    carril-medir limpio=<worktree> estable=<worktree> --search <dir> [--search <dir> ...]

Each run is identified by the folder it worked in: every session file under the search dirs
whose header `cwd` is that worktree belongs to the run. That includes the subagents the run
delegated to, so a lane that delegates more is not made to look cheaper than it is.
"""
from __future__ import annotations

import argparse
from datetime import datetime
import json
import os
from pathlib import Path
import sys


def read_session(path: Path) -> list[dict] | None:
    try:
        lines = path.read_text().splitlines()
    except OSError:
        return None
    events = []
    for line in lines:
        try:
            events.append(json.loads(line))
        except json.JSONDecodeError:
            continue
    return events if events and events[0].get("type") == "session" else None


def timestamp(event: dict) -> datetime | None:
    value = event.get("timestamp")
    if not value:
        return None
    return datetime.fromisoformat(value.replace("Z", "+00:00"))


def sessions_for(worktree: str, search: list[Path],
                 since: datetime | None = None) -> list[list[dict]]:
    wanted = os.path.realpath(worktree)
    found = []
    for directory in search:
        for path in sorted(directory.rglob("*.jsonl")):
            events = read_session(path)
            if not events or os.path.realpath(events[0].get("cwd", "")) != wanted:
                continue
            # A retried run reuses its worktree, so sessions from the failed attempt share
            # its cwd; only the start time tells them apart.
            started = timestamp(events[0])
            if since and (started is None or started < since):
                continue
            found.append(events)
    # Oldest first: the run's own session starts before any subagent it spawns.
    return sorted(found, key=lambda events: timestamp(events[0]) or datetime.max)


def measure(label: str, worktree: str, search: list[Path],
            since: datetime | None = None) -> dict:
    sessions = sessions_for(worktree, search, since)
    run = {"label": label, "worktree": worktree, "sessions": len(sessions)}
    if not sessions:
        return run | dict.fromkeys(
            ("startup_input", "input", "output", "cost", "turns", "tool_calls",
             "tool_errors", "asks", "seconds", "final_stop", "ended_asking"))

    totals = dict(input=0, output=0, cost=0.0, turns=0, tool_calls=0, tool_errors=0, asks=0)
    startup_input = None
    moments = []
    for index, events in enumerate(sessions):
        for event in events:
            moment = timestamp(event)
            if moment:
                moments.append(moment)
            message = event.get("message") or {}
            if message.get("role") == "assistant":
                usage = message.get("usage") or {}
                # Cached prompt tokens are billed apart but were still read by the model;
                # leaving them out makes a warm-cache lane look lighter than it is.
                prompt = (usage.get("input", 0) + usage.get("cacheRead", 0)
                          + usage.get("cacheWrite", 0))
                if index == 0 and startup_input is None:
                    startup_input = prompt
                totals["input"] += prompt
                totals["output"] += usage.get("output", 0)
                totals["cost"] += (usage.get("cost") or {}).get("total", 0.0)
                totals["turns"] += 1
                calls = [part for part in message.get("content") or []
                         if part.get("type") == "toolCall"]
                totals["tool_calls"] += len(calls)
                # Every ask_user_* tool stops the work until the human answers.
                totals["asks"] += sum(
                    1 for part in calls if str(part.get("name", "")).startswith("ask_user"))
            elif message.get("role") == "toolResult" and message.get("isError"):
                totals["tool_errors"] += 1

    final_stop = None
    ended_asking = False
    for event in reversed(sessions[0]):
        message = event.get("message") or {}
        if message.get("role") == "assistant":
            final_stop = message.get("stopReason")
            text = "".join(part.get("text", "") for part in message.get("content") or []
                           if part.get("type") == "text")
            # A run that hands back a question stopped short of doing the work.
            ended_asking = text.rstrip().endswith("?")
            break

    totals["cost"] = round(totals["cost"], 6)
    return run | totals | {
        "startup_input": startup_input,
        "seconds": round((max(moments) - min(moments)).total_seconds()),
        "final_stop": final_stop,
        "ended_asking": ended_asking,
    }


COLUMNS = (
    ("Carril", "label"), ("Sesiones", "sessions"), ("Tokens arranque", "startup_input"),
    ("Tokens entrada", "input"), ("Tokens salida", "output"), ("Costo USD", "cost"),
    ("Turnos", "turns"), ("Herramientas", "tool_calls"), ("Errores", "tool_errors"),
    ("Preguntas", "asks"), ("Segundos", "seconds"), ("Cierre", "final_stop"),
    ("Terminó preguntando", "ended_asking"),
)


def cell(key: str, value) -> str:
    if value is None:
        return "—"
    if key == "cost":
        return f"{value:.3f}"
    return str(value)


def table(runs: list[dict]) -> str:
    header = "| " + " | ".join(title for title, _ in COLUMNS) + " |"
    rule = "|" + "---|" * len(COLUMNS)
    rows = ["| " + " | ".join(cell(key, run[key]) for _, key in COLUMNS) + " |" for run in runs]
    return "\n".join([header, rule, *rows])


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("runs", nargs="+", metavar="carril=worktree")
    parser.add_argument("--search", action="append", default=[], type=Path, required=True)
    parser.add_argument("--json", action="store_true", help="print raw metrics")
    parser.add_argument("--since", type=lambda value: timestamp({"timestamp": value}),
                        help="ignore sessions started before this ISO time")
    args = parser.parse_args(argv)

    runs = []
    for spec in args.runs:
        label, separator, worktree = spec.partition("=")
        if not separator:
            parser.error(f"expected carril=worktree, got {spec!r}")
        runs.append(measure(label, worktree, args.search, args.since))
    print(json.dumps(runs, indent=2) if args.json else table(runs))
    return 0


if __name__ == "__main__":
    sys.exit(main())
