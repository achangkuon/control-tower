#!/usr/bin/env python3
"""Rebuild the global Pi with the private tool-call annotation overlay.

Public Pi releases carry no `registerToolCallAnnotation`. This tool detects an unpatched global
install, applies the pinned overlay (see personal-pi/manifest.json) to the matching upstream tag,
builds and verifies it, then swaps the built `dist` directories in with a backup and a smoke test.
Any failure before the swap leaves the runtime untouched; any failure after it restores the backup.
"""
import argparse
import datetime
import fcntl
import hashlib
import json
import os
from pathlib import Path
import platform
import shutil
import subprocess
import sys
import tarfile
import urllib.request

HERE = Path(__file__).resolve().parent
PACKAGE_NAME = "@earendil-works/pi-coding-agent"
MARKER = "registerToolCallAnnotation"
PATCH_NAME = "0001-tool-call-annotations.patch"

NODE_VERSION = "v24.21.0"
NODE_ARCHIVE = f"node-{NODE_VERSION}-linux-x64.tar.xz"
NODE_URL = f"https://nodejs.org/dist/{NODE_VERSION}/{NODE_ARCHIVE}"
NODE_SHA256 = "fd8e59d5a511510f6a298afb548f18c7d2b1be404d8b4a27d94fbe49f56cb2d6"

EXIT_OK = 0
EXIT_FAILED = 1
EXIT_ENVIRONMENT = 2
EXIT_CONFLICT = 3
EXIT_LOCKED = 4
EXIT_RUNNING = 5
EXIT_ROLLED_BACK = 6
EXIT_RESTORE_FAILED = 7


class RebuildError(Exception):
    def __init__(self, message, code=EXIT_FAILED):
        super().__init__(message)
        self.code = code


def log(message):
    print(f"pi-overlay-rebuild: {message}", file=sys.stderr, flush=True)


def default_overlay_paths():
    """Installed layout first (data next to the tool), then the repository layout."""
    installed = HERE / "pi-overlay"
    repository = HERE.parent.parent / "personal-pi"
    if (installed / "manifest.json").is_file():
        return installed / "manifest.json", installed / PATCH_NAME
    return repository / "manifest.json", repository / "patches" / PATCH_NAME


def locate_package(pi_command):
    """Walk up from the resolved `pi` executable to the pi-coding-agent package directory."""
    if not pi_command:
        raise RebuildError("`pi` was not found on PATH; pass --package-dir", EXIT_ENVIRONMENT)
    current = Path(os.path.realpath(pi_command))
    for candidate in (current, *current.parents):
        manifest = candidate / "package.json"
        if manifest.is_file():
            try:
                if json.loads(manifest.read_text()).get("name") == PACKAGE_NAME:
                    return candidate
            except ValueError:
                pass
    raise RebuildError(f"no {PACKAGE_NAME} package found above {current}", EXIT_ENVIRONMENT)


def read_version(package_dir):
    try:
        version = json.loads((package_dir / "package.json").read_text())["version"]
    except (OSError, ValueError, KeyError) as error:
        raise RebuildError(f"cannot read the Pi version in {package_dir}: {error}", EXIT_ENVIRONMENT)
    if not isinstance(version, str) or not version:
        raise RebuildError("invalid Pi version", EXIT_ENVIRONMENT)
    return version


def is_patched(package_dir):
    dist = package_dir / "dist"
    if not dist.is_dir():
        return False
    needle = MARKER.encode()
    for path in dist.rglob("*.js"):
        try:
            if needle in path.read_bytes():
                return True
        except OSError:
            continue
    return False


def run(command, cwd=None, env=None, capture=False):
    result = subprocess.run(command, cwd=cwd, env=env, capture_output=capture, text=capture)
    if result.returncode:
        detail = f": {result.stderr.strip()}" if capture and result.stderr else ""
        raise RebuildError(f"`{' '.join(command)}` failed with exit {result.returncode}{detail}")
    return result.stdout.strip() if capture else ""


def git(directory, *args, check=True):
    result = subprocess.run(["git", "-C", str(directory), *args], capture_output=True, text=True)
    if check and result.returncode:
        raise RebuildError(f"git {args[0]} failed: {result.stderr.strip()}")
    return result


class Steps:
    """External effects: toolchain, build, verification, process detection, smoke test."""

    def toolchain(self, cache_dir, log):
        env = dict(os.environ)
        probe = subprocess.run(["node", "-e", "process.exit(process.features.typescript ? 0 : 1)"],
                               capture_output=True, env=env)
        if probe.returncode == 0:
            log("using the node on PATH")
            return env
        if platform.system() != "Linux" or platform.machine() not in ("x86_64", "AMD64"):
            raise RebuildError("the node on PATH cannot run TypeScript and automatic Node download "
                               "supports linux-x64 only", EXIT_ENVIRONMENT)
        node_root = Path(cache_dir) / f"node-{NODE_VERSION}"
        bin_dir = node_root / f"node-{NODE_VERSION}-linux-x64" / "bin"
        if not (bin_dir / "node").is_file():
            archive = Path(cache_dir) / NODE_ARCHIVE
            log(f"downloading Node.js {NODE_VERSION}")
            with urllib.request.urlopen(NODE_URL, timeout=120) as response, archive.open("wb") as output:
                shutil.copyfileobj(response, output)
            if hashlib.sha256(archive.read_bytes()).hexdigest() != NODE_SHA256:
                archive.unlink(missing_ok=True)
                raise RebuildError("downloaded Node.js archive failed SHA-256 verification")
            shutil.rmtree(node_root, ignore_errors=True)
            node_root.mkdir(parents=True)
            with tarfile.open(archive) as tar:
                tar.extractall(node_root, filter="data")
        env["PATH"] = f"{bin_dir}{os.pathsep}{env.get('PATH', '')}"
        return env

    def build(self, src, env, log):
        log("npm ci --ignore-scripts")
        run(["npm", "ci", "--ignore-scripts"], cwd=src, env=env)
        log("npm run build")
        run(["npm", "run", "build"], cwd=src, env=env)

    def verify(self, src, env, log):
        log("verifying the overlay tests")
        run(["node", "--test", "test/text-inline-suffix.test.ts"], cwd=Path(src) / "packages/tui", env=env)
        run(["npx", "vitest", "--run", "test/extensions-runner.test.ts",
             "test/tool-execution-component.test.ts"], cwd=Path(src) / "packages/coding-agent", env=env)

    def other_pi_running(self):
        ignored = set()
        pid = os.getpid()
        while pid > 1:
            ignored.add(pid)
            try:
                pid = int(Path(f"/proc/{pid}/stat").read_text().rsplit(")", 1)[1].split()[1])
            except (OSError, ValueError, IndexError):
                break
        for entry in Path("/proc").iterdir():
            if not entry.name.isdigit() or int(entry.name) in ignored:
                continue
            try:
                argv = [a for a in (entry / "cmdline").read_bytes().decode(errors="replace").split("\0") if a]
            except OSError:
                continue
            if not argv or any("pi-overlay-rebuild" in a or "pi-npm-host-peers" in a for a in argv[:3]):
                continue
            first = argv[:2]
            if any(PACKAGE_NAME.split("/")[1] in a or Path(a).name == "pi" for a in first):
                return True
        return False

    def smoke(self, package_dir, version):
        cli = package_dir / "dist/bundle/cli.js"
        result = subprocess.run([str(cli), "--version"], capture_output=True, text=True, timeout=60)
        if result.returncode:
            return f"`cli.js --version` exited {result.returncode}"
        reported = result.stdout.strip()
        if reported != version:
            return f"version mismatch: expected {version}, got {reported!r}"
        if not is_patched(package_dir):
            return "installed dist does not contain the overlay"
        return None


def prepare_source(src, version, manifest, patch_bytes):
    """Clone the upstream tag and apply the overlay. Returns "strict" or "drift"."""
    if hashlib.sha256(patch_bytes).hexdigest() != manifest["patch_sha256"]:
        raise RebuildError("patch SHA-256 does not match the manifest")
    patch = src.parent / "overlay.patch"
    shutil.rmtree(src, ignore_errors=True)
    src.parent.mkdir(parents=True, exist_ok=True)
    patch.write_bytes(patch_bytes)
    tag = f"v{version}"
    log(f"cloning {manifest['upstream']} at {tag}")
    clone = subprocess.run(["git", "clone", "--quiet", "--depth", "1", "--branch", tag, "--",
                            manifest["upstream"], str(src)], capture_output=True, text=True)
    if clone.returncode:
        raise RebuildError(f"cannot clone tag {tag}: {clone.stderr.strip()}")
    head = git(src, "rev-parse", "HEAD").stdout.strip()
    if head == manifest["base_commit"]:
        git(src, "apply", "--index", str(patch))
        if git(src, "write-tree").stdout.strip() != manifest["result_tree"]:
            raise RebuildError("overlay result tree does not match the manifest")
        return "strict"
    log(f"{tag} differs from the pinned base; trying a three-way apply")
    # The three-way merge needs the pinned base blobs; a failed fetch only makes a conflict likelier.
    git(src, "fetch", "--quiet", "--depth", "1", "origin", manifest["base_commit"], check=False)
    applied = git(src, "apply", "--3way", "--index", str(patch), check=False)
    if applied.returncode or git(src, "ls-files", "--unmerged").stdout.strip():
        raise RebuildError(f"the overlay does not apply to Pi {version}; it needs a manual port for "
                           "this version. The installed runtime was not touched.", EXIT_CONFLICT)
    return "drift"


def replace_tree(target, source):
    shutil.rmtree(target)
    shutil.copytree(source, target, symlinks=True)


def install(package_dir, src, version, backup_root, steps):
    targets = (
        (package_dir / "dist", Path(src) / "packages/coding-agent/dist", "coding-agent-dist"),
        (package_dir / "node_modules/@earendil-works/pi-tui/dist", Path(src) / "packages/tui/dist", "pi-tui-dist"),
    )
    for target, built, _ in targets:
        if not built.is_dir():
            raise RebuildError(f"the build produced no {built}")
        if not target.is_dir():
            raise RebuildError(f"the installed runtime has no {target}", EXIT_ENVIRONMENT)
    stamp = datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    backup = backup_root / f"pi-{version}-public-dist-{stamp}"
    backup.mkdir(parents=True)
    for target, _, name in targets:
        shutil.copytree(target, backup / name, symlinks=True)
    log(f"backup written to {backup}")
    try:
        for target, built, _ in targets:
            replace_tree(target, built)
        for relative in ("dist/bundle/cli.js", "dist/cli.js"):
            if (package_dir / relative).is_file():
                os.chmod(package_dir / relative, 0o755)
        failure = steps.smoke(package_dir, version)
    except subprocess.TimeoutExpired:
        failure = "the smoke test timed out"
    except (OSError, shutil.Error, subprocess.SubprocessError) as error:
        failure = f"swap failed: {error}"
    if failure:
        log(f"smoke test failed ({failure}); restoring the backup")
        try:
            for target, _, name in targets:
                # A swap that failed halfway may have removed the target already.
                target.mkdir(parents=True, exist_ok=True)
                replace_tree(target, backup / name)
        except (OSError, shutil.Error) as error:
            raise RebuildError(f"the rebuilt Pi failed verification ({failure}) and the backup could not be "
                               f"restored ({error}). The runtime may be incomplete; restore it manually from "
                               f"{backup}", EXIT_RESTORE_FAILED)
        raise RebuildError(f"the rebuilt Pi failed verification ({failure}); the backup was restored",
                           EXIT_ROLLED_BACK)
    log("installed and verified")


def rebuild(args, steps):
    package_dir = (Path(args.package_dir).resolve() if args.package_dir
                   else locate_package(shutil.which("pi")))
    version = read_version(package_dir)
    log(f"Pi {version} at {package_dir}")
    if not args.force and is_patched(package_dir):
        print(f"Pi {version} already carries the tool-call annotation overlay; nothing to do.")
        return EXIT_OK
    manifest_default, patch_default = default_overlay_paths()
    manifest_path = Path(args.manifest) if args.manifest else manifest_default
    patch_path = Path(args.patch) if args.patch else patch_default
    try:
        manifest = json.loads(manifest_path.read_text())
        patch_bytes = patch_path.read_bytes()
    except (OSError, ValueError) as error:
        raise RebuildError(f"cannot read the overlay manifest or patch: {error}", EXIT_ENVIRONMENT)
    cache_dir = Path(args.cache_dir) if args.cache_dir else Path.home() / ".cache/pi-overlay"
    backup_root = Path(args.backup_root) if args.backup_root else Path.home() / ".pi/agent/backups"
    work = cache_dir / version
    if args.dry_run:
        print(f"Would clone {manifest['upstream']} at v{version} into {work / 'src'}")
        print(f"Would apply {patch_path.name} (strict if the tag is {manifest['base_commit'][:8]}, "
              "otherwise three-way)")
        print("Would build, run the overlay tests, back up both dist directories under "
              f"{backup_root}, install the build and smoke-test it")
        return EXIT_OK
    cache_dir.mkdir(parents=True, exist_ok=True)
    with open(cache_dir / ".lock", "w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise RebuildError("another pi-overlay-rebuild is already running", EXIT_LOCKED)
        work.mkdir(parents=True, exist_ok=True)
        src = work / "src"
        mode = prepare_source(src, version, manifest, patch_bytes)
        log(f"overlay applied ({mode} mode)")
        env = steps.toolchain(cache_dir, log)
        steps.build(src, env, log)
        steps.verify(src, env, log)
        if not args.allow_running and steps.other_pi_running():
            raise RebuildError("another Pi process is running; close it and retry, or pass "
                               "--allow-running", EXIT_RUNNING)
        install(package_dir, src, version, backup_root, steps)
    return EXIT_OK


def main(argv=None, steps=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--package-dir", help="pi-coding-agent package directory (default: from `pi` on PATH)")
    parser.add_argument("--cache-dir", help="work directory root (default: ~/.cache/pi-overlay)")
    parser.add_argument("--backup-root", help="backup root (default: ~/.pi/agent/backups)")
    parser.add_argument("--manifest", help="overlay manifest (default: next to this tool, else the repository)")
    parser.add_argument("--patch", help="overlay patch (default: next to this tool, else the repository)")
    parser.add_argument("--force", action="store_true", help="rebuild even if the runtime already has the overlay")
    parser.add_argument("--dry-run", action="store_true", help="report what would happen and change nothing")
    parser.add_argument("--allow-running", action="store_true", help="install even if another Pi process runs")
    args = parser.parse_args(argv)
    try:
        return rebuild(args, steps or Steps())
    except RebuildError as error:
        log(str(error))
        return error.code
    except (OSError, subprocess.SubprocessError, KeyError) as error:
        log(f"unexpected failure: {error}")
        return EXIT_FAILED


if __name__ == "__main__":
    sys.exit(main())
