{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gentle-ai.local/schemas/unattended-execution-contract-v4.json",
  "title": "Sealed Plan-Session Unattended Execution Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "sealed_at",
    "expires_at",
    "contract_digest",
    "repository",
    "session",
    "permissions",
    "ownership",
    "artifact_policy",
    "execution",
    "review_policy",
    "retries"
  ],
  "properties": {
    "schema_version": { "const": "gentle-ai.unattended-execution-contract/v4" },
    "contract_id": { "$ref": "#/$defs/nonEmpty" },
    "sealed_at": { "$ref": "#/$defs/dateTime" },
    "expires_at": { "$ref": "#/$defs/dateTime" },
    "contract_digest": { "$ref": "#/$defs/sha256" },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "root", "branch", "base_ref", "base_sha"],
      "properties": {
        "identity": { "$ref": "#/$defs/nonEmpty" },
        "root": { "$ref": "#/$defs/absolutePath" },
        "branch": { "type": "string", "pattern": "^work/[^\\s]+$" },
        "base_ref": { "$ref": "#/$defs/nonEmpty" },
        "base_sha": { "$ref": "#/$defs/gitSha" }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sesion_id",
        "radar_status_stdout_sha256",
        "radar_sesion_stdout_sha256",
        "listo_confirmed",
        "unresolved_escalating_decision",
        "solicitud_sdd"
      ],
      "properties": {
        "sesion_id": { "$ref": "#/$defs/nonEmpty" },
        "radar_status_stdout_sha256": { "$ref": "#/$defs/sha256" },
        "radar_sesion_stdout_sha256": { "$ref": "#/$defs/sha256" },
        "listo_confirmed": { "const": true },
        "unresolved_escalating_decision": { "const": false },
        "solicitud_sdd": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requested"],
          "properties": {
            "requested": { "type": "boolean" },
            "evidence": { "$ref": "#/$defs/nonEmpty" }
          },
          "allOf": [
            {
              "if": { "properties": { "requested": { "const": true } }, "required": ["requested"] },
              "then": { "required": ["evidence"] }
            }
          ]
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read_paths", "edit_paths", "commands", "network", "processes", "cleanup_paths", "denied_paths", "denied_effects", "prohibitions"],
      "properties": {
        "read_paths": { "$ref": "#/$defs/pathList" },
        "edit_paths": { "$ref": "#/$defs/pathList" },
        "commands": { "$ref": "#/$defs/commandList" },
        "network": { "$ref": "#/$defs/stringList" },
        "processes": { "$ref": "#/$defs/stringList" },
        "cleanup_paths": { "$ref": "#/$defs/pathList" },
        "denied_paths": { "$ref": "#/$defs/pathList" },
        "denied_effects": { "$ref": "#/$defs/stringListNonEmpty" },
        "prohibitions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["commit", "amend", "rebase", "tag", "push", "pr_create", "pr_update", "merge", "release", "deploy", "db_mutation", "global_closure", "unlisted_sesion", "plan_yaml_write"],
          "properties": {
            "commit": { "type": "boolean" },
            "amend": { "const": true },
            "rebase": { "const": true },
            "tag": { "const": true },
            "push": { "const": true },
            "pr_create": { "const": true },
            "pr_update": { "const": true },
            "merge": { "const": true },
            "release": { "const": true },
            "deploy": { "const": true },
            "db_mutation": { "const": true },
            "global_closure": { "const": true },
            "unlisted_sesion": { "const": true },
            "plan_yaml_write": { "const": true }
          }
        }
      }
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exclusive_paths", "package_manifests", "lockfiles", "generated_outputs", "progress_files", "shared_resources", "known_conflicts"],
      "properties": {
        "exclusive_paths": { "$ref": "#/$defs/pathList" },
        "package_manifests": { "$ref": "#/$defs/pathList" },
        "lockfiles": { "$ref": "#/$defs/pathList" },
        "generated_outputs": { "$ref": "#/$defs/pathList" },
        "progress_files": { "$ref": "#/$defs/pathList" },
        "shared_resources": { "$ref": "#/$defs/stringList" },
        "known_conflicts": { "$ref": "#/$defs/stringList" }
      }
    },
    "artifact_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authored_tracked", "generated_tracked", "ephemeral_untracked", "forbidden_generated", "ignore_policy", "cleanup_policy", "node_modules", "codegraph", "caches"],
      "properties": {
        "authored_tracked": { "$ref": "#/$defs/pathList" },
        "generated_tracked": { "$ref": "#/$defs/pathList" },
        "ephemeral_untracked": { "$ref": "#/$defs/pathList" },
        "forbidden_generated": { "$ref": "#/$defs/pathList" },
        "ignore_policy": { "$ref": "#/$defs/nonEmpty" },
        "cleanup_policy": { "$ref": "#/$defs/nonEmpty" },
        "node_modules": { "$ref": "#/$defs/localArtifactDisposition" },
        "codegraph": { "$ref": "#/$defs/localArtifactDisposition" },
        "caches": { "$ref": "#/$defs/localArtifactDisposition" }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executor", "worker_kickoff_skill", "delivery_ceiling", "state_root"],
      "properties": {
        "executor": { "const": "pi-worker-dispatched-by-chanks-3-despacho-herdr" },
        "worker_kickoff_skill": { "const": "chanks-3-session-kickoff" },
        "delivery_ceiling": { "enum": ["none", "commit"] },
        "state_root": { "$ref": "#/$defs/absolutePath" }
      }
    },
    "review_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["high", "medium", "passive"],
      "properties": {
        "high": { "const": "granted_in_advance" },
        "medium": { "const": "declined" },
        "passive": { "const": "no_consent_needed" }
      }
    },
    "retries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["same_input_transient_before_final_verification", "implementation_corrections_before_final_verification", "authorization_scope", "final_verification_attempts", "retries_after_final_verification_failure", "corrections_after_final_verification_failure"],
      "properties": {
        "same_input_transient_before_final_verification": { "const": 1 },
        "implementation_corrections_before_final_verification": { "const": 2 },
        "authorization_scope": { "const": 0 },
        "final_verification_attempts": { "const": 1 },
        "retries_after_final_verification_failure": { "const": 0 },
        "corrections_after_final_verification_failure": { "const": 0 }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "sesion_id", "worker", "checks", "commits", "changed_paths", "reviews", "stopped_questions", "budget_used"],
      "properties": {
        "state": { "enum": ["COMPLETED", "BLOCKED", "FAILED"] },
        "sesion_id": { "$ref": "#/$defs/nonEmpty" },
        "worker": { "$ref": "#/$defs/nonEmpty" },
        "checks": { "$ref": "#/$defs/evidenceList" },
        "commits": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/gitSha" } },
        "changed_paths": { "$ref": "#/$defs/pathList" },
        "reviews": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["risk", "outcome"],
            "properties": {
              "risk": { "enum": ["high", "medium", "passive"] },
              "outcome": { "enum": ["granted", "declined", "not_needed"] }
            }
          }
        },
        "stopped_questions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["question", "evidence", "options", "decision_class", "checkpoint"],
            "properties": {
              "question": { "$ref": "#/$defs/nonEmpty" },
              "evidence": { "$ref": "#/$defs/nonEmpty" },
              "options": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmpty" } },
              "decision_class": { "$ref": "#/$defs/nonEmpty" },
              "checkpoint": { "$ref": "#/$defs/nonEmpty" }
            }
          }
        },
        "budget_used": { "$ref": "#/$defs/nonEmpty" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "execution": { "properties": { "delivery_ceiling": { "const": "none" } }, "required": ["delivery_ceiling"] } }, "required": ["execution"] },
      "then": { "properties": { "permissions": { "properties": { "prohibitions": { "properties": { "commit": { "const": true } } } } } } }
    },
    {
      "if": { "properties": { "execution": { "properties": { "delivery_ceiling": { "const": "commit" } }, "required": ["delivery_ceiling"] } }, "required": ["execution"] },
      "then": { "properties": { "permissions": { "properties": { "prohibitions": { "properties": { "commit": { "const": false } } } } } } }
    }
  ],
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1, "pattern": "^(?!.*(?:TBD|TODO|PENDING|PLACEHOLDER|<[^>]+>)).+$" },
    "absolutePath": { "type": "string", "pattern": "^/[^\\u0000]+$" },
    "dateTime": { "type": "string", "format": "date-time" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "gitSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "stringList": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmpty" } },
    "stringListNonEmpty": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmpty" } },
    "pathList": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/exactPath" } },
    "exactPath": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*[*?\\[\\]{}]).+$" },
    "commandList": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^(?:bun|go|npm|pnpm|python3?|pytest|node|git|radar|make|cargo)(?: [^;|&`$<>\\n]*)?$" } },
    "localArtifactDisposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disposition", "paths"],
      "properties": {
        "disposition": { "enum": ["absent", "read-only", "ephemeral", "generated-tracked", "forbidden"] },
        "paths": { "$ref": "#/$defs/pathList" }
      }
    },
    "evidenceList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "exit_code", "stdout_sha256", "stderr_sha256", "started_at", "ended_at"],
        "properties": {
          "command": { "$ref": "#/$defs/nonEmpty" },
          "exit_code": { "type": "integer" },
          "stdout_sha256": { "$ref": "#/$defs/sha256" },
          "stderr_sha256": { "$ref": "#/$defs/sha256" },
          "started_at": { "$ref": "#/$defs/dateTime" },
          "ended_at": { "$ref": "#/$defs/dateTime" }
        }
      }
    }
  }
}
