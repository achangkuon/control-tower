+#[test]
+fn skill_output_preserves_activation_ownership_and_approval_contracts() {
+    let output = Command::new(env!("CARGO_BIN_EXE_herdr"))
+        .arg("--skill")
+        .env_remove("HERDR_SOCKET_PATH")
+        .env_remove("HERDR_CLIENT_SOCKET_PATH")
+        .env_remove("HERDR_ENV")
+        .output()
+        .unwrap();
+
+    assert!(
+        output.status.success(),
+        "status={:?} stderr={}",
+        output.status.code(),
+        String::from_utf8_lossy(&output.stderr)
+    );
+    let skill = String::from_utf8(output.stdout).unwrap();
+    assert!(skill.starts_with("---\nname: herdr\n"), "skill: {skill}");
+    assert!(
+        skill.contains("Use only when the user explicitly mentions Herdr or asks to use Herdr"),
+        "skill must retain its narrow explicit-Herdr trigger: {skill}"
+    );
+    assert!(
+        skill.contains("Control Tower dispatch") && skill.contains("torre asiento"),
+        "skill must defer Tower seat ownership to torre asiento: {skill}"
+    );
+    assert!(
+        skill.contains("Inspect the blocked UI and ask the user before answering it")
+            && skill.contains("Never authorize via `agent send-keys` autonomously"),
+        "skill must require human approval for blocked agent UI: {skill}"
+    );
+}
