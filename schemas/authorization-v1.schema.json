{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://control-tower.local/schemas/authorization-v1.schema.json",
  "type": "object", "additionalProperties": false, "required": ["schema", "schema_version", "authorization_id", "action", "project_id", "registry_revision", "plan_id", "jornada_id", "jornada_revision", "policy_report_digest", "created_at", "expires_at", "nonce_hash", "state"],
  "properties": {"schema": {"const": "authorization"}, "schema_version": {"const": 1}, "authorization_id": {"$ref": "artifact-ref-v1.schema.json#/$defs/slug"}, "action": {"enum": ["MERGE", "START_JORNADA"]}, "project_id": {"$ref": "artifact-ref-v1.schema.json#/$defs/slug"}, "registry_revision": {"$ref": "artifact-ref-v1.schema.json#/$defs/revision"}, "plan_id": {"$ref": "artifact-ref-v1.schema.json#/$defs/slug"}, "jornada_id": {"$ref": "artifact-ref-v1.schema.json#/$defs/slug"}, "jornada_revision": {"$ref": "artifact-ref-v1.schema.json#/$defs/revision"}, "delivery": {"type": "object", "additionalProperties": false, "required": ["shape", "repository", "target_branch", "base_sha", "head_sha"], "properties": {"shape": {"enum": ["pull-request", "direct-push"]}, "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"}, "number": {"type": "integer", "minimum": 1}, "target_branch": {"type": "string", "minLength": 1}, "base_sha": {"$ref": "artifact-ref-v1.schema.json#/$defs/gitSha"}, "head_sha": {"$ref": "artifact-ref-v1.schema.json#/$defs/gitSha"}}, "allOf": [{"if": {"properties": {"shape": {"const": "pull-request"}}, "required": ["shape"]}, "then": {"required": ["number"]}, "else": {"not": {"required": ["number"]}}}]}, "jornada_snapshot": {"type": "object"}, "policy_report_digest": {"$ref": "artifact-ref-v1.schema.json#/$defs/digest"}, "created_at": {"$ref": "artifact-ref-v1.schema.json#/$defs/timestamp"}, "expires_at": {"$ref": "artifact-ref-v1.schema.json#/$defs/timestamp"}, "nonce_hash": {"$ref": "artifact-ref-v1.schema.json#/$defs/digest"}, "state": {"enum": ["PENDING", "APPROVED", "REJECTED", "EXPIRED", "REVOKED"]}, "extensions": {"$ref": "artifact-ref-v1.schema.json#/$defs/extensions"}},
  "allOf": [{"if": {"properties": {"action": {"const": "MERGE"}}, "required": ["action"]}, "then": {"required": ["delivery"]}, "else": {"not": {"required": ["delivery"]}}}, {"if": {"properties": {"action": {"const": "START_JORNADA"}}, "required": ["action"]}, "then": {"required": ["jornada_snapshot"]}}]
}
