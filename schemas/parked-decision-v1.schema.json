{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://control-tower.local/schemas/parked-decision-v1.schema.json","type":"object","additionalProperties":false,
  "required":["schema","schema_version","parked_decision_id","parked_decision_digest","question","evidence","options","origin","checkpoint","decision_class","created_at","frozen_scope"],
  "properties":{"schema":{"const":"parked-decision"},"schema_version":{"const":1},"parked_decision_id":{"$ref":"artifact-ref-v1.schema.json#/$defs/slug"},"parked_decision_digest":{"$ref":"artifact-ref-v1.schema.json#/$defs/digest"},"question":{"type":"string","minLength":1},"evidence":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/evidence"}},"options":{"type":"array","minItems":2,"items":{"$ref":"#/$defs/option"}},"origin":{"$ref":"#/$defs/origin"},"checkpoint":{"type":"string","minLength":1},"decision_class":{"$ref":"#/$defs/decisionClass"},"created_at":{"$ref":"artifact-ref-v1.schema.json#/$defs/timestamp"},"frozen_scope":{"$ref":"#/$defs/scope"}},
  "$defs":{
    "sessionId":{"type":"string","pattern":"^S[1-9][0-9]*\\.[1-9][0-9]*$"},"moduleId":{"type":"string","pattern":"^M[1-9][0-9]*\\.[1-9][0-9]*\\.[1-9][0-9]*$"},
    "decisionClass":{"enum":["contrato visible del producto","operaciones irreversibles","migraciones o pérdida de datos","API pública","seguridad y permisos","dinero, precios o cuotas","expansión de alcance","dependencias o evidencia contradictorias"]},
    "evidence":{"type":"object","additionalProperties":false,"required":["path","line_start","line_end","contradiction"],"properties":{"path":{"$ref":"artifact-ref-v1.schema.json#/$defs/relativePath"},"line_start":{"type":"integer","minimum":1},"line_end":{"type":"integer","minimum":1},"contradiction":{"type":"string","minLength":1}}},
    "option":{"type":"object","additionalProperties":false,"required":["option_id","label","consequence"],"properties":{"option_id":{"$ref":"artifact-ref-v1.schema.json#/$defs/slug"},"label":{"type":"string","minLength":1},"consequence":{"type":"string","minLength":1}}},
    "origin":{"type":"object","additionalProperties":false,"required":["session_id","module_id"],"properties":{"session_id":{"$ref":"#/$defs/sessionId"},"module_id":{"$ref":"#/$defs/moduleId"}}},
    "scope":{"type":"object","additionalProperties":false,"required":["session_plan_snapshot_digest","session_ids","area","resources"],"properties":{"session_plan_snapshot_digest":{"$ref":"artifact-ref-v1.schema.json#/$defs/digest"},"session_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/sessionId"}},"area":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},"resources":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}}}}
  }
}
