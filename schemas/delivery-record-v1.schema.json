{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://control-tower.local/schemas/delivery-record-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "candidate_revision", "revision", "previous_revision", "state", "shape", "authorization_ref", "attempt", "process_receipt_digest", "created_at"],
  "properties": {
    "schema": {"const": "delivery-record"},
    "schema_version": {"const": 1},
    "candidate_revision": {"$ref": "artifact-ref-v1.schema.json#/$defs/digest"},
    "revision": {"type": "integer", "minimum": 1},
    "previous_revision": {"type": "integer", "minimum": 0},
    "state": {"enum": ["ATTEMPT_FAILED", "DELIVERED", "UNRECONCILED"]},
    "shape": {"enum": ["direct-push", "pull-request"]},
    "authorization_ref": {"type": "string", "minLength": 1},
    "attempt": {"type": "integer", "minimum": 0, "maximum": 3},
    "process_receipt_digest": {"anyOf": [{"$ref": "artifact-ref-v1.schema.json#/$defs/digest"}, {"const": "absent"}]},
    "classification": {"enum": ["quota_exhausted", "provider_unavailable", "checks_pending", "unknown"]},
    "reconciled": {"type": "boolean"},
    "created_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{3})?Z$"}
  },
  "allOf": [
    {"if": {"properties": {"state": {"const": "ATTEMPT_FAILED"}}}, "then": {"required": ["classification"]}},
    {"if": {"properties": {"state": {"const": "UNRECONCILED"}}}, "then": {"required": ["classification"], "properties": {"classification": {"const": "unknown"}}}},
    {"if": {"properties": {"state": {"const": "DELIVERED"}}}, "then": {"required": ["reconciled"]}}
  ]
}
