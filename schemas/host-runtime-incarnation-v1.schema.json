{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://control-tower.local/schemas/host-runtime-incarnation-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "incarnation_id"
  ],
  "properties": {
    "schema_version": {
      "const": "control-tower.host-runtime.incarnation/v1"
    },
    "incarnation_id": {
      "type": "string",
      "pattern": "^ct_incarnation_[0-9a-f]{32}$"
    }
  }
}
