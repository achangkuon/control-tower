{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://control-tower.local/schemas/policy-report-v1.schema.json",
  "type": "object", "additionalProperties": false, "required": ["schema", "schema_version", "report_id", "project_id", "plan_id", "policy_identity", "created_at", "expires_at", "inputs", "decision", "eligible_slices", "blocked_slices", "drift", "effective_limits", "required_approvals", "conflicts", "evidence_refs", "authority_attestation_ref"],
  "properties": {"schema": {"const": "policy-report"}, "schema_version": {"const": 1}, "report_id": {"$ref": "artifact-ref-v1.schema.json#/$defs/slug"}, "project_id": {"$ref": "artifact-ref-v1.schema.json#/$defs/slug"}, "plan_id": {"$ref": "artifact-ref-v1.schema.json#/$defs/slug"}, "policy_identity": {"type": "string", "minLength": 1}, "created_at": {"$ref": "artifact-ref-v1.schema.json#/$defs/timestamp"}, "expires_at": {"$ref": "artifact-ref-v1.schema.json#/$defs/timestamp"}, "inputs": {"type": "object", "additionalProperties": false, "required": ["manifest_ref", "binding_delta_refs", "runtime_projection_revision", "jornada_id", "jornada_revision"], "properties": {"manifest_ref": {"$ref": "artifact-ref-v1.schema.json#/$defs/pointer"}, "binding_delta_refs": {"type": "array", "items": {"$ref": "artifact-ref-v1.schema.json#/$defs/pointer"}}, "runtime_projection_revision": {"type": "integer", "minimum": 0}, "jornada_id": {"$ref": "artifact-ref-v1.schema.json#/$defs/slug"}, "jornada_revision": {"$ref": "artifact-ref-v1.schema.json#/$defs/revision"}}}, "decision": {"enum": ["READY_FOR_PLANNING", "READY_FOR_APPLY", "APPROVAL_REQUIRED", "BLOCKED", "PLAN_COMPLETE"]}, "eligible_slices": {"type": "array", "items": {"$ref": "artifact-ref-v1.schema.json#/$defs/slug"}, "uniqueItems": true}, "blocked_slices": {"type": "array", "items": {"$ref": "artifact-ref-v1.schema.json#/$defs/slug"}, "uniqueItems": true}, "drift": {"type": "object", "additionalProperties": false, "required": ["classification", "categories", "rationale"], "properties": {"classification": {"enum": ["COMPATIBLE", "MATERIAL", "AMBIGUOUS", "NOT_APPLICABLE"]}, "categories": {"type": "array", "items": {"type": "string"}}, "rationale": {"type": "string", "minLength": 1}}}, "effective_limits": {"type": "object"}, "required_approvals": {"type": "array"}, "conflicts": {"type": "array"}, "evidence_refs": {"type": "array", "items": {"$ref": "artifact-ref-v1.schema.json#/$defs/pointer"}}, "authority_attestation_ref": {"type": "string", "minLength": 1}, "extensions": {"$ref": "artifact-ref-v1.schema.json#/$defs/extensions"}}
