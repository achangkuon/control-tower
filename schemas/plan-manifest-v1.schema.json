{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://control-tower.local/schemas/plan-manifest-v1.schema.json",
  "type": "object", "additionalProperties": false, "required": ["schema", "schema_version", "artifact_id", "project_id", "plan_id", "artifact_revision", "created_at", "producer", "objective", "artifact_refs", "jornada_policy", "delivery_policy", "slices", "constraints", "non_goals", "binding_delta_refs", "campaign_refs"],
  "properties": {"schema": {"const": "plan-manifest"}, "schema_version": {"const": 1}, "artifact_id": {"$ref": "artifact-ref-v1.schema.json#/$defs/slug"}, "project_id": {"$ref": "artifact-ref-v1.schema.json#/$defs/slug"}, "plan_id": {"$ref": "artifact-ref-v1.schema.json#/$defs/slug"}, "artifact_revision": {"$ref": "artifact-ref-v1.schema.json#/$defs/revision"}, "created_at": {"$ref": "artifact-ref-v1.schema.json#/$defs/timestamp"}, "producer": {"$ref": "artifact-ref-v1.schema.json#/$defs/producer"}, "objective": {"type": "string", "minLength": 1}, "artifact_refs": {"type": "object", "additionalProperties": false, "required": ["prd", "rfc", "requirements", "roadmap"], "properties": {"prd": {"$ref": "artifact-ref-v1.schema.json#/$defs/pointer"}, "rfc": {"$ref": "artifact-ref-v1.schema.json#/$defs/pointer"}, "requirements": {"$ref": "artifact-ref-v1.schema.json#/$defs/pointer"}, "roadmap": {"$ref": "artifact-ref-v1.schema.json#/$defs/pointer"}}}, "jornada_policy": {"type": "object", "additionalProperties": false, "required": ["default_preset", "allowed_presets"], "properties": {"default_preset": {"type": "string", "minLength": 1}, "allowed_presets": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}}}, "delivery_policy": {"type": "object", "additionalProperties": false, "required": ["automatic_commit", "automatic_push", "automatic_pr", "automatic_merge"], "properties": {"automatic_commit": {"type": "boolean"}, "automatic_push": {"type": "boolean"}, "automatic_pr": {"type": "boolean"}, "automatic_merge": {"const": false}}}, "slices": {"type": "array", "items": {"$ref": "#/$defs/slice"}}, "constraints": {"type": "array"}, "non_goals": {"type": "array"}, "binding_delta_refs": {"type": "array", "items": {"$ref": "artifact-ref-v1.schema.json#/$defs/pointer"}}, "campaign_refs": {"type": "array", "items": {"$ref": "artifact-ref-v1.schema.json#/$defs/pointer"}}, "extensions": {"$ref": "artifact-ref-v1.schema.json#/$defs/extensions"}},
  "$defs": {"slice": {"type": "object", "additionalProperties": false, "required": ["slice_id", "goal", "dependencies", "openspec_change", "acceptance_refs"], "properties": {"slice_id": {"$ref": "artifact-ref-v1.schema.json#/$defs/slug"}, "goal": {"type": "string", "minLength": 1}, "dependencies": {"type": "array", "items": {"$ref": "artifact-ref-v1.schema.json#/$defs/slug"}, "uniqueItems": true}, "openspec_change": {"$ref": "artifact-ref-v1.schema.json#/$defs/slug"}, "acceptance_refs": {"type": "array", "items": {"$ref": "artifact-ref-v1.schema.json#/$defs/pointer"}}, "extensions": {"$ref": "artifact-ref-v1.schema.json#/$defs/extensions"}}}}
}
