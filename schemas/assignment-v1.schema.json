{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://control-tower.local/schemas/assignment-v1.schema.json",
  "type": "object", "additionalProperties": false, "required": ["schema", "schema_version", "assignment_id", "assignment_revision", "project_id", "registry_revision", "plan_id", "slice_id", "role", "lane", "jornada_id", "jornada_revision", "host", "host_epoch", "attempt", "session_name", "workspace", "inputs", "expires_at"],
  "properties": {"schema": {"const": "assignment"}, "schema_version": {"const": 1}, "assignment_id": {"$ref": "artifact-ref-v1.schema.json#/$defs/slug"}, "assignment_revision": {"$ref": "artifact-ref-v1.schema.json#/$defs/revision"}, "project_id": {"$ref": "artifact-ref-v1.schema.json#/$defs/slug"}, "registry_revision": {"$ref": "artifact-ref-v1.schema.json#/$defs/revision"}, "plan_id": {"$ref": "artifact-ref-v1.schema.json#/$defs/slug"}, "slice_id": {"$ref": "artifact-ref-v1.schema.json#/$defs/slug"}, "role": {"enum": ["planning", "implementation"]}, "lane": {"enum": ["planning", "apply"]}, "jornada_id": {"$ref": "artifact-ref-v1.schema.json#/$defs/slug"}, "jornada_revision": {"$ref": "artifact-ref-v1.schema.json#/$defs/revision"}, "host": {"enum": ["pi", "opencode", "claude"]}, "host_epoch": {"$ref": "artifact-ref-v1.schema.json#/$defs/revision"}, "attempt": {"$ref": "artifact-ref-v1.schema.json#/$defs/revision"}, "session_name": {"type": "string", "minLength": 1, "maxLength": 160}, "workspace": {"type": "object", "additionalProperties": false, "required": ["path", "branch", "base_sha"], "properties": {"path": {"type": "string", "pattern": "^/"}, "branch": {"type": "string", "minLength": 1}, "base_sha": {"$ref": "artifact-ref-v1.schema.json#/$defs/gitSha"}}}, "inputs": {"type": "array", "items": {"$ref": "artifact-ref-v1.schema.json#/$defs/pointer"}}, "expires_at": {"$ref": "artifact-ref-v1.schema.json#/$defs/timestamp"}, "extensions": {"$ref": "artifact-ref-v1.schema.json#/$defs/extensions"}}
}
