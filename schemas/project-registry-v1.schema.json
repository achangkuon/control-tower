{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://control-tower.local/schemas/project-registry-v1.schema.json",
  "type": "object", "additionalProperties": false, "required": ["schema", "schema_version", "registry_revision", "projects"],
  "properties": {"schema": {"const": "project-registry"}, "schema_version": {"const": 1}, "registry_revision": {"$ref": "artifact-ref-v1.schema.json#/$defs/revision"}, "projects": {"type": "array", "items": {"$ref": "#/$defs/project"}}, "extensions": {"$ref": "artifact-ref-v1.schema.json#/$defs/extensions"}},
  "$defs": {"project": {"type": "object", "additionalProperties": false, "required": ["project_id", "aliases", "canonical_root", "git_common_dir", "expected_remote", "main_branch", "main_session", "manifest_path", "roadmap_path", "main_store_path", "allowed_hosts", "registry_entry_revision"], "properties": {"project_id": {"$ref": "artifact-ref-v1.schema.json#/$defs/slug"}, "aliases": {"type": "array", "items": {"$ref": "artifact-ref-v1.schema.json#/$defs/slug"}, "uniqueItems": true}, "canonical_root": {"type": "string", "pattern": "^/"}, "git_common_dir": {"type": "string", "pattern": "^/"}, "expected_remote": {"type": "string", "minLength": 1}, "main_branch": {"type": "string", "minLength": 1}, "main_session": {"type": "string", "pattern": "-main$"}, "manifest_path": {"$ref": "artifact-ref-v1.schema.json#/$defs/relativePath"}, "roadmap_path": {"$ref": "artifact-ref-v1.schema.json#/$defs/relativePath"}, "main_store_path": {"type": "string", "pattern": "^/"}, "allowed_hosts": {"type": "array", "items": {"enum": ["pi", "opencode", "claude"]}, "uniqueItems": true}, "registry_entry_revision": {"$ref": "artifact-ref-v1.schema.json#/$defs/revision"}, "extensions": {"$ref": "artifact-ref-v1.schema.json#/$defs/extensions"}}}}
}
