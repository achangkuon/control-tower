{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://control-tower.local/schemas/jornada-v1.schema.json",
  "type": "object", "additionalProperties": false, "required": ["schema", "schema_version", "jornada_id", "jornada_revision", "project_id", "registry_revision", "plan_id", "preset", "preset_revision", "effective_limits", "starts_at", "expires_at", "execution_host", "allowed_operations", "manifest_ref", "authorization_ref", "state"],
  "properties": {"schema": {"const": "jornada"}, "schema_version": {"const": 1}, "jornada_id": {"$ref": "artifact-ref-v1.schema.json#/$defs/slug"}, "jornada_revision": {"$ref": "artifact-ref-v1.schema.json#/$defs/revision"}, "project_id": {"$ref": "artifact-ref-v1.schema.json#/$defs/slug"}, "registry_revision": {"$ref": "artifact-ref-v1.schema.json#/$defs/revision"}, "plan_id": {"$ref": "artifact-ref-v1.schema.json#/$defs/slug"}, "preset": {"type": "string", "minLength": 1}, "preset_revision": {"$ref": "artifact-ref-v1.schema.json#/$defs/revision"}, "effective_limits": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}, "starts_at": {"$ref": "artifact-ref-v1.schema.json#/$defs/timestamp"}, "expires_at": {"$ref": "artifact-ref-v1.schema.json#/$defs/timestamp"}, "execution_host": {"enum": ["pi", "opencode", "claude"]}, "fallback_host": {"enum": ["pi", "opencode", "claude"]}, "allowed_operations": {"type": "array", "items": {"enum": ["CREATE_COMMIT", "PUSH_BRANCH", "CREATE_OR_UPDATE_PR", "REQUEST_MERGE_AUTHORIZATION", "MERGE_PR", "POST_MERGE_VERIFY"]}, "uniqueItems": true}, "manifest_ref": {"$ref": "artifact-ref-v1.schema.json#/$defs/pointer"}, "authorization_ref": {"$ref": "artifact-ref-v1.schema.json#/$defs/pointer"}, "state": {"enum": ["DRAFT", "PENDING_AUTHORIZATION", "ACTIVE", "PAUSED", "BLOCKED", "REJECTED", "EXPIRED", "REVOKED", "COMPLETED"]}, "extensions": {"$ref": "artifact-ref-v1.schema.json#/$defs/extensions"}}
}
