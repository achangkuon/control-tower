{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://control-tower.local/schemas/support-proposal-v1.schema.json","type":"object","additionalProperties":false,
  "required":["schema","schema_version","proposal_id","project_id","caller_role","checkpoint_ref","plan_enumeration_digest","ledger_digest","worker_claim","primary","alternatives","conflicts","evidence_refs","expires_at","state"],
  "properties":{"schema":{"const":"support-proposal"},"schema_version":{"const":1},"proposal_id":{"$ref":"artifact-ref-v1.schema.json#/$defs/slug"},"project_id":{"$ref":"artifact-ref-v1.schema.json#/$defs/slug"},"caller_role":{"const":"MAIN"},"checkpoint_ref":{"$ref":"artifact-ref-v1.schema.json#/$defs/pointer"},"plan_enumeration_digest":{"$ref":"artifact-ref-v1.schema.json#/$defs/digest"},"ledger_digest":{"$ref":"artifact-ref-v1.schema.json#/$defs/digest"},"worker_claim":{"$ref":"artifact-ref-v1.schema.json#/$defs/slug"},"primary":{"type":"object","additionalProperties":false,"required":["module_id","task_ids"],"properties":{"module_id":{"type":"string","pattern":"^M[0-9]+(?:\\.[0-9]+)+$"},"task_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^T[0-9]+(?:\\.[0-9]+)+$"}}}},"alternatives":{"type":"array","items":{"type":"object"}},"conflicts":{"type":"array","items":{"type":"object"}},"evidence_refs":{"type":"array","items":{"$ref":"artifact-ref-v1.schema.json#/$defs/pointer"}},"expires_at":{"$ref":"artifact-ref-v1.schema.json#/$defs/timestamp"},"state":{"enum":["EXECUTABLE","NO_SCOPE","CLAIM_MISMATCH","STALE"]}}
