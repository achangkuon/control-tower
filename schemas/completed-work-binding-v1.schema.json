        "session_id":{"type":"string","minLength":1},"module_id":{"type":"string","minLength":1}}}}},
    "assumption_digest":{"$ref":"artifact-ref-v1.schema.json#/$defs/digest"},
    "binding_digest":{"$ref":"artifact-ref-v1.schema.json#/$defs/digest"}
  }
}
