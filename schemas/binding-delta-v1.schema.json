{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://control-tower.local/schemas/binding-delta-v1.schema.json",
  "type": "object", "additionalProperties": false, "required": ["schema", "schema_version", "artifact_id", "project_id", "plan_id", "artifact_revision", "created_at", "producer", "slice_id", "assignment_id", "assignment_revision", "inputs", "git", "contracts", "deviations", "new_constraints", "dependency_impact", "next_slice_impact", "verification_evidence", "producer_drift_assessment"],
  "properties": {"schema": {"const": "binding-delta"}, "schema_version": {"const": 1}, "artifact_id": {"$ref": "artifact-ref-v1.schema.json#/$defs/slug"}, "project_id": {"$ref": "artifact-ref-v1.schema.json#/$defs/slug"}, "plan_id": {"$ref": "artifact-ref-v1.schema.json#/$defs/slug"}, "artifact_revision": {"$ref": "artifact-ref-v1.schema.json#/$defs/revision"}, "created_at": {"$ref": "artifact-ref-v1.schema.json#/$defs/timestamp"}, "producer": {"$ref": "artifact-ref-v1.schema.json#/$defs/producer"}, "slice_id": {"$ref": "artifact-ref-v1.schema.json#/$defs/slug"}, "assignment_id": {"$ref": "artifact-ref-v1.schema.json#/$defs/slug"}, "assignment_revision": {"$ref": "artifact-ref-v1.schema.json#/$defs/revision"}, "inputs": {"$ref": "#/$defs/inputs"}, "git": {"$ref": "#/$defs/git"}, "contracts": {"$ref": "#/$defs/contracts"}, "deviations": {"type": "array"}, "new_constraints": {"type": "array"}, "dependency_impact": {"type": "array"}, "next_slice_impact": {"type": "array"}, "verification_evidence": {"type": "array", "items": {"$ref": "artifact-ref-v1.schema.json#/$defs/pointer"}}, "producer_drift_assessment": {"type": "object", "additionalProperties": false, "required": ["classification", "categories", "rationale"], "properties": {"classification": {"enum": ["compatible", "material", "ambiguous", "not-applicable"]}, "categories": {"type": "array", "items": {"type": "string"}}, "rationale": {"type": "string", "minLength": 1}}}, "extensions": {"$ref": "artifact-ref-v1.schema.json#/$defs/extensions"}},
  "$defs": {"inputs": {"type": "object", "additionalProperties": false, "required": ["manifest", "proposal", "specs", "design", "tasks", "previous_delta"], "properties": {"manifest": {"$ref": "artifact-ref-v1.schema.json#/$defs/pointer"}, "proposal": {"$ref": "artifact-ref-v1.schema.json#/$defs/pointer"}, "specs": {"type": "array", "items": {"$ref": "artifact-ref-v1.schema.json#/$defs/pointer"}}, "design": {"$ref": "artifact-ref-v1.schema.json#/$defs/pointer"}, "tasks": {"$ref": "artifact-ref-v1.schema.json#/$defs/pointer"}, "previous_delta": {"anyOf": [{"type": "null"}, {"$ref": "artifact-ref-v1.schema.json"}]}}}, "git": {"type": "object", "additionalProperties": false, "required": ["base_sha", "result_sha", "branch", "pull_request"], "properties": {"base_sha": {"$ref": "artifact-ref-v1.schema.json#/$defs/gitSha"}, "result_sha": {"$ref": "artifact-ref-v1.schema.json#/$defs/gitSha"}, "branch": {"type": "string", "minLength": 1}, "pull_request": {"anyOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["repository", "number"], "properties": {"repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"}, "number": {"type": "integer", "minimum": 1}}}]}}}, "contracts": {"type": "object", "additionalProperties": false, "required": ["added", "changed", "removed"], "properties": {"added": {"type": "array"}, "changed": {"type": "array"}, "removed": {"type": "array"}}}}
}
