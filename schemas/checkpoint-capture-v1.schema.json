{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://control-tower.local/schemas/checkpoint-capture-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "checkpoint_id", "digest", "project_id", "assignment_id", "generation", "repository_root", "git_common_dir", "base", "result", "files"],
  "properties": {
    "schema": {"const": "checkpoint-capture"},
    "schema_version": {"const": 1},
    "checkpoint_id": {"type": "string", "pattern": "^checkpoint-[0-9a-f]{64}$"},
    "digest": {"$ref": "artifact-ref-v1.schema.json#/$defs/digest"},
    "project_id": {"$ref": "artifact-ref-v1.schema.json#/$defs/slug"},
    "assignment_id": {"$ref": "artifact-ref-v1.schema.json#/$defs/slug"},
    "generation": {"type": "integer", "minimum": 0},
    "repository_root": {"type": "string", "pattern": "^/"},
    "git_common_dir": {"type": "string", "pattern": "^/"},
    "base": {"$ref": "#/$defs/gitIdentity"},
    "result": {"$ref": "#/$defs/gitIdentity"},
    "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}}
  },
  "$defs": {
    "oid": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "gitIdentity": {
      "type": "object", "additionalProperties": false, "required": ["commit", "tree"],
      "properties": {"commit": {"$ref": "#/$defs/oid"}, "tree": {"$ref": "#/$defs/oid"}}
    },
    "file": {
      "type": "object", "additionalProperties": false, "required": ["path", "mode", "git_mode", "digest"],
      "properties": {
        "path": {"$ref": "artifact-ref-v1.schema.json#/$defs/relativePath"},
        "mode": {"enum": ["raw-bytes", "rfc8785-jcs"]},
        "git_mode": {"type": "string", "pattern": "^[0-7]{6}$"},
        "digest": {"$ref": "artifact-ref-v1.schema.json#/$defs/digest"}
      }
    }
  }
}
