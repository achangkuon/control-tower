#!/usr/bin/env sh
# Three jobs at delivery time, in order: run the suite, validate the plan, then regenerate
# the report. Only the suite and plan validation can block a push.
#
# Agent-agnostic on purpose: git runs it for Claude Code, opencode, PI, Codex and for a
# human alike. Nothing here depends on which assistant is driving. That is the point —
# a gate each runtime enforces differently is not a gate.
#
# Why pre-push and not pre-commit: radar validates one immutable HEAD snapshot
# (git.go:61 pins HEAD^{commit}). At pre-commit time HEAD is the state BEFORE the commit,
# so the gate would validate stale data and would report every newly added file as
# unowned. At pre-push time HEAD already carries the commits being published, which is
# exactly what must be validated.
#
# The two sections below differ deliberately in how they resolve their engine. The report
# loads a script through an interpreter the user already trusts and never blocks, so a
# repo-relative lookup is acceptable there. The gate EXECUTES a binary and can stop a
# push, so it refuses any candidate that lives inside the tree being pushed.
set -u

root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0

# ── 1. The suite gate — this one BLOCKS ──────────────────────────────────────
# The hook also runs from fixture repositories in the plan-gate tests. Gate only when this
# hook physically belongs to the pushed root; external fixture hooks continue to Radar.
gated=0
master_local_sha=""
while read -r _local_ref pushed_local_sha remote_ref _remote_sha; do
  if [ "$remote_ref" = "refs/heads/master" ]; then
    gated=1
    master_local_sha=$pushed_local_sha
  fi
done

hook_dir=$(CDPATH= cd -P "$(dirname "$0")" 2>/dev/null && pwd -P) || hook_dir=""
root_hooks_dir=$(CDPATH= cd -P "$root/.githooks" 2>/dev/null && pwd -P) || root_hooks_dir=""

if [ "$gated" -eq 1 ] && [ -n "$hook_dir" ] && [ "$hook_dir" = "$root_hooks_dir" ]; then
  if [ "$master_local_sha" != "$(git rev-parse 'HEAD^{commit}' 2>/dev/null)" ] ||
    ! git diff --quiet || ! git diff --cached --quiet ||
    [ -n "$(git ls-files --others --exclude-standard)" ]
  then
    printf 'pre-push: el commit master a publicar debe ser el HEAD limpio del checkout. Push rechazado.\n' >&2
    exit 1
  fi
  if ! command -v bun >/dev/null 2>&1; then
    printf 'pre-push: bun no está disponible, no se puede verificar. Push rechazado.\n' >&2
    exit 1
  fi

  if [ ! -f "$root/package.json" ]; then
    printf 'pre-push: falta package.json válido; no se puede verificar. Push rechazado.\n' >&2
    exit 1
  fi

  bun -e '
    let pkg
    try {
      pkg = JSON.parse(await Bun.file(process.argv.at(-1)).text())
    } catch {
      process.exit(3)
    }
    if (pkg?.scripts?.test !== "bun test") process.exit(2)
  ' "$root/package.json" 2>/dev/null
  package_status=$?
  if [ "$package_status" -eq 3 ]; then
    printf 'pre-push: package.json inválido; no se puede verificar. Push rechazado.\n' >&2
    exit 1
  fi
  if [ "$package_status" -ne 0 ]; then
    printf 'pre-push: scripts.test debe ser exactamente "bun test". Push rechazado.\n' >&2
    exit 1
  fi

  # bin/torre must resolve these modules from the checkout being delivered.
  export CONTROL_TOWER_CORE="$root/core.mjs"
  export CONTROL_TOWER_LIFECYCLE="$root/install/lifecycle.mjs"

  # Git exports these variables to hooks. Unset them only for the suite so fixture
  # repositories created by tests cannot operate on this repository; later stages retain
  # their inherited environment.
  printf 'pre-push: corriendo la suite contra este checkout...\n' >&2
  if ! (
    cd "$root" &&
    unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_COMMON_DIR \
          GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_QUARANTINE_PATH &&
    bun run test
  ); then
    printf '\npre-push: la suite falló. Push rechazado.\n' >&2
    printf 'pre-push: arreglalo, o pusheá con --no-verify y decí por qué.\n' >&2
    exit 1
  fi
  printf 'pre-push: suite verde.\n' >&2
fi

# ── 2. The plan gate — this one BLOCKS ───────────────────────────────────────
# Resolve a path to the destination the kernel would actually execute: absolute, with
# every symlink on the way followed. `readlink -f` is not portable and `realpath` is not
# guaranteed either, so this walks the components with `pwd -P` and `readlink`, which
# POSIX does specify. Exits non-zero when the path cannot be resolved.
real_destination() {
  _rd_path=$1
  case "$_rd_path" in
    /*) ;;
    *) _rd_path="$(pwd)/$_rd_path" ;;
  esac
  _rd_hops=0
  while [ "$_rd_hops" -lt 40 ]; do
    _rd_hops=$((_rd_hops + 1))
    _rd_dir=$(CDPATH= cd -P "$(dirname "$_rd_path")" 2>/dev/null && pwd -P) || return 1
    _rd_path=$_rd_dir/$(basename "$_rd_path")
    [ -L "$_rd_path" ] || break
    _rd_link=$(readlink "$_rd_path") || return 1
    case "$_rd_link" in
      /*) _rd_path=$_rd_link ;;
      *) _rd_path=$_rd_dir/$_rd_link ;;
    esac
  done
  [ -e "$_rd_path" ] || return 1
  printf '%s\n' "$_rd_path"
}

# True when $1 is $2 or lives under it. A literal prefix comparison, not a glob, so paths
# carrying shell metacharacters are still compared as text.
path_inside() {
  [ "$1" = "$2" ] && return 0
  _pi_suffix=${1#"$2"/}
  [ "$_pi_suffix" != "$1" ]
}

# No plan, no gate: a project that never adopted the method is not failing it. Same for
# a machine without radar — a missing tool is not a broken plan, so it warns and passes.
if [ -f "$root/openspec/plan.yaml" ]; then
  # Engine lookup. NEVER execute a binary from inside the working tree: a hook that
  # prefers a repo-relative executable runs whatever a checked-out branch happens to
  # carry, which is binary planting with the contributor's own privileges. Only three
  # sources are trusted — PATH, an explicit RADAR_BIN, and the fixed install location —
  # and every one of them is chosen by the user, not by the content being pushed. Even
  # then a candidate is resolved to its real destination first: RADAR_BIN and PATH both
  # accept relative paths and symlinks, and either can end inside the tree being pushed.
  root_real=$(real_destination "$root" 2>/dev/null) || root_real=$root
  radar=""
  try_radar() {
    [ -n "$1" ] && [ -x "$1" ] || return 1
    _tr_destination=$(real_destination "$1") || return 1
    if path_inside "$_tr_destination" "$root_real"; then
      printf 'radar: candidato dentro del checkout, se descarta: %s\n' "$1" >&2
      return 1
    fi
    radar=$1
  }
  # `command -v` can name a builtin, an alias or a function rather than a file; only a
  # path can be resolved and executed, so anything without a slash is ignored.
  path_radar=$(command -v radar 2>/dev/null) || path_radar=""
  case "$path_radar" in */*) ;; *) path_radar="" ;; esac
  try_radar "$path_radar" ||
    try_radar "${RADAR_BIN:-}" ||
    try_radar "$HOME/.local/bin/radar" ||
    :

  if [ -z "$radar" ]; then
    printf 'radar: no encontrado, se omite la validación del plan. El push sigue.\n' >&2
    printf '       Instalalo con agent-workflows/tools/install-radar.sh\n' >&2
  else
    # Bound the run. This blocking hook runs for
    # unattended agents with nobody present to Ctrl-C a hang and retry with --no-verify.
    # A gate that can hang forever is worse than no gate: an expired check warns and
    # lets the push through, because a timeout is not evidence of an invalid plan.
    #
    # Expiry is recorded explicitly, never inferred from an exit code: radar is free to
    # exit 124 for its own reasons, and reading that as "timed out, let it through" would
    # turn an invalid plan into a silent pass.
    # One path, always. timeout(1) is not usable here: it returns 124 both when IT expires
    # and when the child itself exits 124, so an invalid plan that happened to exit 124
    # would be waved through as "timed out". It is also absent on stock macOS. A watchdog
    # that writes an explicit marker has neither problem and behaves the same everywhere.
    gate_timeout=120
    expired=""
    marker=$(mktemp 2>/dev/null) || marker=""

    (cd "$root" && "$radar" check) &
    radar_pid=$!

    watchdog_pid=""
    if [ -n "$marker" ]; then
      # Redirected: a watchdog holding git's stderr keeps the push waiting even after
      # radar has already answered.
      { sleep "$gate_timeout"
        kill -TERM "$radar_pid" 2>/dev/null && printf 'expired' > "$marker"
      } >/dev/null 2>&1 &
      watchdog_pid=$!
    fi

    wait "$radar_pid"
    status=$?

    if [ -n "$watchdog_pid" ]; then
      kill -TERM "$watchdog_pid" >/dev/null 2>&1
      wait "$watchdog_pid" >/dev/null 2>&1
    fi

    if [ -n "$marker" ]; then
      [ -s "$marker" ] && expired="yes"
      rm -f "$marker"
    fi

    if [ -n "$expired" ]; then
      printf 'radar: la validación excedió %ss, se omite. El push sigue.\n' "$gate_timeout" >&2
    elif [ "$status" -ne 0 ]; then
      printf '\n'
      printf 'radar: el plan no valida. El push se detuvo.\n' >&2
      printf '       Corregí openspec/plan.yaml y volvé a intentar.\n' >&2
      printf '       Para saltear esta validación una vez: git push --no-verify\n' >&2
      exit 1
    fi
  fi
fi

# ── 3. The report — this one NEVER blocks ────────────────────────────────────
# A report is not a gate; a stale report labels itself stale.
[ -f "$root/radiografia.json" ] || exit 0
command -v bun >/dev/null 2>&1 || exit 0

# Engine lookup, most specific first. A missing engine is not an error: the repo simply
# has no report until agent-workflows is present on this machine.
for candidate in \
  "${RADIOGRAFIA_HOME:-}" \
  "$root/agent-workflows/radiografia" \
  "$(dirname "$root")/agent-workflows/radiografia" \
  "$HOME/projects/agent-workflows/radiografia"
do
  [ -n "$candidate" ] && [ -f "$candidate/run.mjs" ] && engine="$candidate" && break
done

if [ -z "${engine:-}" ]; then
  printf 'radiografía: motor no encontrado, se omite. El push sigue.\n' >&2
  exit 0
fi

printf 'radiografía: regenerando el informe...\n'
(cd "$root" && bun "$engine/run.mjs") || \
  printf 'radiografía: no se pudo regenerar. El push sigue.\n' >&2
exit 0
