#!/usr/bin/env sh
# Regenerates the product report at delivery time. Delivery in this repo is a direct
# commit to master plus a push, so the push is the moment the report must be true.
#
# Agent-agnostic on purpose: git runs it for Claude Code, opencode, PI, Codex and for a
# human alike. Nothing here depends on which assistant is driving.
#
# It never blocks a push. A report is not a gate; a stale report just labels itself stale.
set -u

root=$(git rev-parse --show-toplevel) || exit 0
command -v bun >/dev/null 2>&1 || exit 0

printf 'radiografía: corriendo la suite y regenerando el informe...\n'
if ! bun "$root/scripts/radiografia.mjs" --with-tests; then
  printf 'radiografía: no se pudo regenerar. El push sigue.\n' >&2
fi
exit 0
