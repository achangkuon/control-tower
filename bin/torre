#!/usr/bin/env bash
# torre — control de la Torre de Control agentica.
#
# Resuelve el repo desde el directorio actual, igual que hace la torre para
# identificar a cada agente. Fuera de un repo, usa los atajos por proyecto
# (torrestk / torreecom / torrefp) o pasá --repo <ruta>.
#
#   torre on       arma el repo: habilita coordinacion y entrega
#   torre off      desarma sin borrar estado; solo permite inspeccion y liberar locks
#   torre status    quien esta registrado, en que estado y quien tiene los locks
#   torre log      sigue el registro en vivo (ctrl-c para salir)
#   torre unlock   libera un lock cuya sesion murio (pide confirmacion)
#   torre asiento  asientos de trabajo: list | abrir <asiento> | limpiar [--confirmar]
#   torre reset    borra el estado de la torre en este repo
#
# El interruptor es un archivo y no depende de que el MCP funcione. `torre off`
# lo elimina desde core para esperar cualquier escritura protegida en curso.

set -euo pipefail

ENTRYPOINT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
if [[ "${1:-}" == "asiento" ]]; then
    # Seat topology belongs to the Tower, but this door is deliberately open while the Tower is
    # off: it never reads ACTIVE, and it shares hosts/herdr-topology.mjs with the launch path.
    exec bun "$ENTRYPOINT_DIR/../hosts/seat-cli.mjs" "${@:2}"
fi
if [[ "${1:-}" == "launch-worker" ]]; then
    # This command has no legacy compatibility path: its provider is packaged
    # beside this executable and validates the installed runtime identity.
    exec bun "$ENTRYPOINT_DIR/../hosts/launch-worker-cli.mjs" "${@:2}"
fi

ACTIVE_CORE=""
ACTIVE_LIFECYCLE=""
ACTIVE_POINTER="$ENTRYPOINT_DIR/../install/active-pointer.mjs"
if [[ "${1:-}" != "--help" && ( -z "${CONTROL_TOWER_CORE:-}" || -z "${CONTROL_TOWER_LIFECYCLE:-}" ) && -f "$ACTIVE_POINTER" ]]; then
    DATA_ROOT=$(bun -e 'const t=await import(process.argv[1]); process.stdout.write(t.resolveDataRoot(process.env))' \
      "$ACTIVE_POINTER")
    if ! active_runtime=$(bun -e '
      const t = await import(process.argv[1])
      const runtime = t.resolveActiveRuntime(process.argv[2])
      if (runtime) process.stdout.write(`${runtime.core}\n${runtime.lifecycle}`)
    ' "$ACTIVE_POINTER" "$DATA_ROOT" 2>&1); then
        printf '%s\n' "$active_runtime" >&2
        exit 1
    fi
    if [[ -n "$active_runtime" ]]; then
        ACTIVE_CORE="${active_runtime%%$'\n'*}"
        ACTIVE_LIFECYCLE="${active_runtime#*$'\n'}"
    fi
fi
CORE="${CONTROL_TOWER_CORE:-${ACTIVE_CORE:-$HOME/.config/opencode/control-tower/core.mjs}}"
LIFECYCLE="${CONTROL_TOWER_LIFECYCLE:-${ACTIVE_LIFECYCLE:-$ENTRYPOINT_DIR/../install/lifecycle.mjs}}"

case "${1:-}" in
    install|diagnose|upgrade|rollback|uninstall)
        exec bun "$LIFECYCLE" "$@"
        ;;
    create-worker|create-session|create-worktree)
        echo "CT_V2_ONLY: $1" >&2
        exit 1
        ;;
esac

repo_dir=""
args=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --repo) repo_dir="${2:-}"; shift 2 ;;
        *) args+=("$1"); shift ;;
    esac
done
set -- "${args[@]:-}"

cd "${repo_dir:-$PWD}" 2>/dev/null || { echo "torre: no existe $repo_dir" >&2; exit 1; }

if ! common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null); then
    cat >&2 <<'EOF'
torre: esto no es un repositorio git.

Pará dentro de un repo, o usá un atajo por proyecto:
  torrestk    Servi-Task-U
  torreecom   ecom-ecuador
  torrefp     Finanzas-Personales
EOF
    exit 1
fi

ROOT="$common/control-tower"
ACTIVE="$ROOT/ACTIVE"
DB="$ROOT/tower.db"
PROJECT=$(basename "$(dirname "$(dirname "$common")")")
VOCABULARY="$ENTRYPOINT_DIR/../console/vocabulary.mjs"
VALIDATOR="$ENTRYPOINT_DIR/../console/validate.mjs"
EXECUTOR="$ENTRYPOINT_DIR/../console/executor.mjs"
CONSOLE_AVAILABLE=false
if [[ -f "$VOCABULARY" && -f "$VALIDATOR" && -f "$EXECUTOR" ]]; then
    CONSOLE_AVAILABLE=true
fi

console_help() {
    bun -e '
      const { COMMAND_VOCABULARY, VERBS } = await import(process.argv[1])
      console.log("Console commands:")
      for (const verb of VERBS) {
        const spec = COMMAND_VOCABULARY[verb]
        const flags = [...Object.keys(spec.required), ...Object.keys(spec.optional)]
          .map((name) => ` --${name.replaceAll("_", "-")} <value>`).join("")
        console.log(`  ${verb}${flags}`)
      }
    ' "$VOCABULARY"
}

run_console_command() {
    bun -e '
      import { randomUUID } from "node:crypto"
      import { readFileSync } from "node:fs"
      const [corePath, vocabularyPath, validatorPath, executorPath, cwd, common, defaultTower, verb, ...argv] = process.argv.slice(1)
      const core = await import(corePath)
      const { COMMAND_VOCABULARY } = await import(vocabularyPath)
      const { CONFIRMATION_TTL_MS, validateConfirmation, validateProposal } = await import(validatorPath)
      const { createConsoleExecutor } = await import(executorPath)
      const spec = COMMAND_VOCABULARY[verb]
      const params = {}, allowed = new Set([...Object.keys(spec.required), ...Object.keys(spec.optional)])
      let towerId = defaultTower
      for (let index = 0; index < argv.length; index += 2) {
        const flag = argv[index], value = argv[index + 1]
        if (!flag?.startsWith("--") || value === undefined) { params.__malformed = true; break }
        const name = flag.slice(2).replaceAll("-", "_")
        if (name === "tower") towerId = value
        else if (allowed.has(name)) params[name] = value
        else params[name] = value
      }
      const handle = core.open(cwd)
      try {
        const localStatus = core.status(handle)
        const agents = Object.fromEntries(localStatus.agents.map(({ name, ...agent }) => [name, {
          ...agent, has_worktree: typeof agent.branch === "string" && agent.branch.length > 0,
        }]))
        const context = {
          registry: { [towerId]: { tower_id: towerId, tower_digest: common, active: localStatus.active, agents } },
          escalations: localStatus.escalations ?? {}, pendingConfirmations: {},
        }
        const executor = createConsoleExecutor({ send: (directive) => core.send(handle, directive), readStatus: () => localStatus })
        let validation = validateProposal({ verb, tower_id: towerId, params }, context)
        if (validation.code === "CV_CONFIRMATION_REQUIRED") {
          const issuedAt = Date.now(), token = randomUUID()
          const pending = { tower_id: towerId, token, issued_at: issuedAt,
            expires_at: issuedAt + CONFIRMATION_TTL_MS, command: validation.confirmation.command }
          console.log(JSON.stringify({ ...validation, confirmation: { ...validation.confirmation,
            token, issuedAt, expiresAt: pending.expires_at } }))
          const supplied = readFileSync(0, "utf8").trim()
          context.pendingConfirmations[towerId] = pending
          validation = validateConfirmation({ tower_id: towerId, token: supplied }, { ...context, now: Date.now() })
        }
        const outcome = executor.execute(validation)
        console.log(JSON.stringify(outcome))
        if (outcome.ok !== true) process.exitCode = 2
      } finally { handle.db?.close() }
    ' "$CORE" "$VOCABULARY" "$VALIDATOR" "$EXECUTOR" "$PWD" "$common" "$PROJECT" "$@"
}

estado() { [[ -f "$ACTIVE" ]] && echo "ARMADA" || echo "desarmada"; }
flag() {
    local wanted="$1"; shift
    while [[ $# -gt 0 ]]; do
        [[ "$1" == "$wanted" ]] && { printf '%s' "${2:-}"; return; }
        shift
    done
}

tabla() {
    if [[ ! -f "$DB" ]]; then
        echo "  (nadie registrado todavia)"
        return
    fi
    bun -e '
      const t = await import(process.argv[1])
      const h = t.open(process.argv[2])
      const s = t.status(h)
      const pad = (v, n) => String(v ?? "-").slice(0, n).padEnd(n)
      if (!s.active && s.agents.length > 0) {
        console.log("  AVISO: registros retenidos (STALE); son historial y no representan sesiones activas.\n")
      }
      if (s.agents.length === 0) console.log("  (nadie registrado todavia)")
      else console.log(`  ${pad("agente", 14)}${pad("rol", 14)}${pad("rama", 30)}${pad("estado", 14)}cola`)
      for (const a of s.agents) {
        console.log(`  ${pad(a.name, 14)}${pad(a.role, 14)}${pad(a.branch, 30)}${pad(a.state, 14)}${a.pending} pend`)
      }
      const l = s.locks.map((x) => `${x.name} → ${x.holder}`).join(", ")
      console.log(`\n  locks: ${l || "ninguno"}`)
      const parados = s.agents.filter((a) => t.NEEDS_HUMAN.includes(a.state))
      if (parados.length > 0) {
        console.log(`\n  TE NECESITAN: ${parados.map((a) => `${a.name} (${a.state})`).join(", ")}`)
        for (const a of parados) if (a.note) console.log(`    ${a.name}: ${a.note}`)
      }
      h.db.close()
    ' "$CORE" "$PWD" 2>/dev/null || echo "  (no se pudo leer el estado)"
}

if [[ "${1:-}" == "--help" ]]; then
    echo "Legacy commands: install diagnose upgrade rollback uninstall main-config provision-main bootstrap-admin on off status log unlock reset"
    if [[ "$CONSOLE_AVAILABLE" == true ]]; then console_help; fi
    exit 0
fi
if [[ "$CONSOLE_AVAILABLE" == true ]] && \
  bun -e 'const { VERBS } = await import(process.argv[1]); process.exit(VERBS.includes(process.argv[2]) ? 0 : 1)' \
    "$VOCABULARY" "${1:-}"; then
    run_console_command "$@"
    exit $?
fi

case "${1:-}" in
    main-config)
        bun -e 'const t=await import(process.argv[1]); const c=t.deriveCanonicalMainContext(process.cwd()); console.log(JSON.stringify({context:c}))' "$CORE"
        ;;
    provision-main)
        bun -e 'const t=await import(process.argv[1]); console.log(JSON.stringify(t.provisionMainAuthorityAnchor({request_identity:process.argv[2],expected_config_digest:process.argv[3]},process.cwd())))' \
          "$CORE" "$(flag --request-identity "${@:2}")" "$(flag --expected-config-digest "${@:2}")"
        ;;
    bootstrap-admin)
        bun -e 'const t=await import(process.argv[1]); console.log(JSON.stringify(t.bootstrapAdmin({request_identity:process.argv[2],expected_anchor_id:process.argv[3],expected_schema_version:Number(process.argv[4]),target_schema_version:Number(process.argv[5]),expected_mode:process.argv[6]},process.cwd())))' \
          "$CORE" "$(flag --request-identity "${@:2}")" "$(flag --expected-anchor-id "${@:2}")" \
          "$(flag --expected-schema-version "${@:2}")" "$(flag --target-schema-version "${@:2}")" "$(flag --expected-mode "${@:2}")"
        ;;
    on)
        mkdir -p "$ROOT"
        touch "$ACTIVE"
        echo "torre · $PROJECT · ARMADA"
        echo "  los agentes registrados van a recibir mensajes al terminar cada turno"
        echo "  para cortar: torre off"
        ;;
    off)
        bun -e '
          const t = await import(process.argv[1])
          const h = t.open(process.argv[2])
          try { t.deactivate(h) } finally { h.db?.close() }
        ' "$CORE" "$PWD"
        echo "torre · $PROJECT · desarmada"
        echo "  estado, mensajes e historial preservados; no se aceptan operaciones nuevas"
        echo "  siguen disponibles: torre status y torre unlock; para reanudar: torre on"
        ;;
    status | "")
        echo "torre · $PROJECT · $(estado)"
        echo
        tabla
        ;;
    log)
        mkdir -p "$ROOT"
        touch "$ROOT/tower.log"
        echo "torre · $PROJECT · $(estado) · siguiendo el loop (ctrl-c para salir)"
        echo
        # Las lineas que requieren intervencion humana van en rojo: mirando
        # pasar mensajes no se puede distinguir "avanza" de "se paro para
        # siempre", que es justo lo unico que necesitas ver a tiempo.
        tail -n 20 -f "$ROOT/tower.log" | awk '
            /TE NECESITA:/ { printf "\033[1;31m%s\033[0m\n", $0; fflush(); next }
            /waking/       { printf "\033[0;36m%s\033[0m\n", $0; fflush(); next }
            /lock|esperando/ { printf "\033[0;33m%s\033[0m\n", $0; fflush(); next }
                           { print; fflush() }
        '
        ;;
    unlock)
        # Salida cuando la sesion que tenia el token murio: sin esto, la unica
        # via es `reset`, que ademas borra estado y cola.
        if [[ ! -f "$DB" ]]; then echo "torre · $PROJECT · no hay torre iniciada"; exit 0; fi
        bun -e '
          const t = await import(process.argv[1])
          const h = t.open(process.argv[2])
          const name = process.argv[3]
          const held = t.status(h).locks
          if (held.length === 0) { console.log("  no hay locks tomados"); h.db.close(); process.exit(0) }
          if (!name) {
            console.log("  locks tomados:")
            for (const l of held) console.log(`    ${l.name} → ${l.holder} (desde ${l.acquired_at})`)
            console.log("\n  liberá con: torre unlock <lock>")
            h.db.close(); process.exit(0)
          }
          const target = held.find((l) => l.name === name)
          if (!target) { console.log(`  nadie tiene "${name}"`); h.db.close(); process.exit(0) }
          console.log(`  ${name} lo tiene ${target.holder} desde ${target.acquired_at}`)
          h.db.close()
          process.exit(10)
        ' "$CORE" "$PWD" "${2:-}" || rc=$?
        # El `|| rc=$?` es obligatorio: con `set -e`, el exit 10 que usamos
        # como "hay algo que liberar" abortaria el script antes de preguntar.
        [[ "${rc:-0}" -ne 10 ]] && exit 0
        printf '\n  Liberarlo a la fuerza? Solo hacelo si esa sesion ya no existe. [s/N]: '
        read -r ok
        if [[ "$ok" =~ ^[SsYy]$ ]]; then
            bun -e '
              const t = await import(process.argv[1])
              const h = t.open(process.argv[2])
              const r = t.forceRelease(h, process.argv[3])
              console.log(`  ${process.argv[3]} liberado (lo tenía ${r.was})`)
              h.db.close()
            ' "$CORE" "$PWD" "$2"
        else
            echo "  cancelado"
        fi
        ;;
    reset)
        # Confirmacion explicita: se pierde el estado, la cola y los locks.
        printf 'Borrar todo el estado de la torre en %s? [s/N]: ' "$PROJECT"
        read -r ok
        if [[ "$ok" =~ ^[SsYy]$ ]]; then
            rm -rf "$ROOT"
            echo "torre · $PROJECT · estado borrado"
        else
            echo "cancelado"
        fi
        ;;
    *)
        echo "torre: no conozco \"$1\"" >&2
        echo "usá: torre [install|diagnose|upgrade|rollback|uninstall|main-config|provision-main|bootstrap-admin|on|off|status|log|unlock|reset] [--repo <ruta>]" >&2
        exit 1
        ;;
esac
