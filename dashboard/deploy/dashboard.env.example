# Documentation template only. Keep the real file outside every release.
# Set values only in /etc/control-tower-dashboard/dashboard.env as root.
# Empty values are intentionally unusable and make startup fail closed.
DASHBOARD_AUTH_USERNAME=
DASHBOARD_AUTH_PASSWORD_HASH=
DASHBOARD_AUTH_REVISION=
DASHBOARD_SESSION_SECRET=
DASHBOARD_AUTH_DISABLED=
DASHBOARD_HOST=
DASHBOARD_PORT=
